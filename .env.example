APP_NAME="Flow Exam Prep"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local: sqlite. Laravel Cloud injects DB_* for the attached Postgres database.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=flow_exam_prep
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ---- Exam prep ----
# Gate 0: while false, no item can move to "released", so candidates see nothing.
EXAMPREP_RELEASE_GATE_OPEN=false
EXAMPREP_PUBLISHER="AS Behavioral and Mental Health Services"
EXAMPREP_AUTHOR_NAME="Americo Silva, MS, BCBA, IBA"
EXAMPREP_AUTHOR_CREDENTIAL="BACB Certification No. 1-21-53901"
# Days a learner cookie lives. Clearing practice data deletes it immediately.
EXAMPREP_LEARNER_COOKIE_DAYS=365

# Cloudflare Turnstile on staff sign-in (optional). Test keys: see docs/CLOUDFLARE.md.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
